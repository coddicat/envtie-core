# syntax=docker/dockerfile:1.7
# EnvTie.dev runner with the official adapters at /adapters. Build flags match
# the release workflow exactly, so adapter SHA-256 pins are identical to the
# linux binaries on the GitHub release (see /adapters/SHA256SUMS.txt).
FROM --platform=$BUILDPLATFORM golang:1.27.2-alpine AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build <<'EOF'
set -eu
mkdir -p /out/adapters /out/work
for name in envtie adapter-neon adapter-upstash adapter-github adapter-stripe; do
  dest=/out/adapters/$name
  [ "$name" = envtie ] && dest=/out/envtie
  CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -buildvcs=false \
    -ldflags="-s -w -X main.version=${VERSION}" -o "$dest" "./cmd/$name"
done
cd /out/adapters && sha256sum -- * > SHA256SUMS.txt
EOF

FROM gcr.io/distroless/static-debian12:nonroot
ARG VERSION=dev
LABEL org.opencontainers.image.title="envtie-runner" \
      org.opencontainers.image.description="EnvTie.dev runner with official adapters; provider credentials stay in your infrastructure" \
      org.opencontainers.image.source="https://github.com/coddicat/envtie-core" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}"
COPY --from=build /out/envtie /envtie
COPY --from=build /out/adapters /adapters
COPY --from=build --chown=nonroot:nonroot /out/work /work
WORKDIR /work
USER nonroot:nonroot
ENTRYPOINT ["/envtie"]
CMD ["runner", "execute"]
